      "query": "¿Quién ganó el GP de Monza en 2019?",
      "expected_tool": "get_race_results",
      "expected_params": {"year": 2019, "circuit_contains": "Monza"},
      "expected_keywords": ["Leclerc", "Ferrari", "Italian Grand Prix"]
    },
