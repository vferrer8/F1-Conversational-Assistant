{
  "metadata": {
    "version": "1.0",
    "description": "Banco de pruebas de referencia para el agente F1-GPT. Cada consulta declara la herramienta esperada, parámetros mínimos y un fragmento de respuesta verificable. El campo 'category' clasifica la consulta en descriptiva, predictiva, comparativa o fuera de dominio (control negativo).",
    "n_queries": 20,
    "categories": {
      "descriptive": 10,
      "predictive": 4,
      "comparative": 4,
      "out_of_domain": 2
    }
  },
