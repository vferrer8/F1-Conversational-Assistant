# Copia este archivo como `.env` y rellena los valores reales.
# No subas el `.env` al repositorio público.
# Lo leen el agent-service (desarrollo local) y docker compose.

# Clave de Google AI Studio para Gemini.
GEMINI_API_KEY=

# Modelo de Gemini (opcional) y modelos de respaldo si está saturado (503/504).
# GEMINI_MODEL=models/gemini-flash-lite-latest
# GEMINI_FALLBACK_MODELS=["models/gemini-flash-latest"]

# Timeout por llamada al LLM, en segundos (opcional).
# LLM_TIMEOUT_S=40
